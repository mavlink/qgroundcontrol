{
    "version": 1,
    "fileType": "SettingsUI",
    "groups": [
        {
            "component": "NmeaGpsSettings",
            "sectionName": "NMEA GPS",
            "keywords": [
                "nmea",
                "gps",
                "serial",
                "baud rate",
                "external gps"
            ]
        },
        {
            "component": "LocalRtkSettings",
            "sectionName": "Local GNSS Receiver",
            "keywords": ["gps", "gnss", "position", "role", "rtk", "receiver", "base", "usb", "serial", "tcp", "udp", "network", "auto connect"]
        },
        {
            "heading": "UDP RTCM Input",
            "keywords": ["udp rtcm"],
            "controls": [
                {
                    "setting": "ntripSettings.rtcmUdpInputEnabled"
                },
                {
                    "setting": "ntripSettings.rtcmUdpInputPort",
                    "enableWhen": "QGroundControl.settingsManager.ntripSettings.rtcmUdpInputEnabled.rawValue"
                },
                {
                    "setting": "ntripSettings.rtcmUdpValidate",
                    "enableWhen": "QGroundControl.settingsManager.ntripSettings.rtcmUdpInputEnabled.rawValue"
                }
            ]
        }
    ]
}
