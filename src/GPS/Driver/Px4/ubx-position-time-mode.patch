+int GPSDriverUBX::disableTimeMode()
+{
+	// Hardware generations alone cannot distinguish M8N/M8P or M9N/F9P.
+	// Skip only known non-base firmware/models; otherwise require an ACK.
+	if (_time_mode_unsupported) {
+		return 0;
+	}
+
+	if (_proto_ver_27_or_higher) {
+		// After a timeout, an ACK cannot be attributed to a later VALSET.
+		if (_valset_ack_ambiguous) {
+			return -1;
+		}
+
+		int msg_size = initCfgValset();
+		cfgValset<uint8_t>(UBX_CFG_KEY_TMODE_MODE, 0 /* Disabled */, msg_size);
+
+		if (!sendMessage(UBX_MSG_CFG_VALSET, _tx_cfg_valset_buf, msg_size)) {
+			return -1;
+		}
+
+		if (waitForAck(UBX_MSG_CFG_VALSET, UBX_CONFIG_TIMEOUT, true) < 0) {
+			return -1;
+		}
+
+		return verifyConfigValue(UBX_CFG_KEY_TMODE_MODE, 0);
+	}
+
+	memset(&_buf.payload_tx_cfg_tmode3, 0, sizeof(_buf.payload_tx_cfg_tmode3));
+
+	if (!sendMessage(UBX_MSG_CFG_TMODE3, (uint8_t *)&_buf, sizeof(_buf.payload_tx_cfg_tmode3))) {
+		return -1;
+	}
+
+	if (waitForAck(UBX_MSG_CFG_TMODE3, UBX_CONFIG_TIMEOUT, true) < 0
+	    || !sendMessage(UBX_MSG_CFG_TMODE3, nullptr, 0)) {
+		return -1;
+	}
+
+	return waitForConfigResponse(UBX_MSG_CFG_TMODE3);
+}
+
+int GPSDriverUBX::verifyConfigValue(uint32_t key, uint8_t value)
+{
+	// Poll one byte-sized key from RAM; the response identifies the key and layer.
+	uint8_t request[8] {};
+	for (unsigned i = 0; i < 4; ++i) {
+		request[4 + i] = (key >> (8 * i)) & 0xff;
+	}
+
+	if (!sendMessage(UBX_MSG_CFG_VALGET, request, sizeof(request))) {
+		return -1;
+	}
+
+	_config_readback_key = key;
+	_config_readback_value = value;
+	return waitForConfigResponse(UBX_MSG_CFG_VALGET);
+}
+
+int GPSDriverUBX::waitForConfigResponse(uint16_t msg)
+{
+	_config_readback_active = true;
+	_config_readback_received = false;
+	const int ret = waitForAck(msg, UBX_CONFIG_TIMEOUT, true);
+	_config_readback_active = false;
+	return ret == 0 && _config_readback_received ? 0 : -1;
 }


