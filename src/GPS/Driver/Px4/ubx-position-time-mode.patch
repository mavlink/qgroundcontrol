+int GPSDriverUBX::disableTimeMode()
+{
+	// Hardware generations alone cannot distinguish M8N/M8P or M9N/F9P.
+	// Skip only known non-base firmware/models; otherwise require an ACK.
+	if (_time_mode_unsupported) {
+		return 0;
+	}
+
+	if (_proto_ver_27_or_higher) {
+		int msg_size = initCfgValset();
+		cfgValset<uint8_t>(UBX_CFG_KEY_TMODE_MODE, 0 /* Disabled */, msg_size);
+
+		if (!sendMessage(UBX_MSG_CFG_VALSET, _tx_cfg_valset_buf, msg_size)) {
+			return -1;
+		}
+
+		return waitForAck(UBX_MSG_CFG_VALSET, UBX_CONFIG_TIMEOUT, true);
+	}
+
+	memset(&_buf.payload_tx_cfg_tmode3, 0, sizeof(_buf.payload_tx_cfg_tmode3));
+
+	if (!sendMessage(UBX_MSG_CFG_TMODE3, (uint8_t *)&_buf, sizeof(_buf.payload_tx_cfg_tmode3))) {
+		return -1;
+	}
+
+	return waitForAck(UBX_MSG_CFG_TMODE3, UBX_CONFIG_TIMEOUT, true);
+}
