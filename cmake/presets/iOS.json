{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 8,
  "include": ["common.json"],
  "configurePresets": [
    {
      "name": "ios-base",
      "hidden": true,
      "generator": "Ninja",
      "inherits": ["ccache"],
      "toolchainFile": "$penv{QT_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_SYSTEM_NAME": "iOS",
        "QGC_CPACK_GENERATOR": "",
        "QT_HOST_PATH": "$penv{QT_HOST_PATH}",
        "Qt6LinguistTools_DIR": "$penv{QT_HOST_PATH}/lib/cmake/Qt6LinguistTools"
      }
    },
    {
      "name": "iOS",
      "displayName": "iOS Release",
      "inherits": ["release", "ios-base"],
      "binaryDir": "${sourceDir}/build/iOS"
    },
    {
      "name": "iOS-appstore",
      "displayName": "iOS App Store Release",
      "generator": "Xcode",
      "inherits": ["release", "ios-base"],
      "binaryDir": "${sourceDir}/build/iOS-appstore"
    },
    {
      "name": "iOS-debug",
      "displayName": "iOS Debug",
      "inherits": ["debug-no-tests", "ios-base"],
      "binaryDir": "${sourceDir}/build/iOS-debug"
    },
    {
      "name": "iOS-simulator",
      "displayName": "iOS Simulator Debug (x86_64)",
      "inherits": ["debug-no-tests", "lean-debug", "ios-base"],
      "binaryDir": "${sourceDir}/build/iOS-simulator",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OBJC_FLAGS_DEBUG": "-g1",
        "CMAKE_OBJCXX_FLAGS_DEBUG": "-g1"
      }
    }
  ],
  "buildPresets": [
    { "name": "iOS", "configurePreset": "iOS", "configuration": "Release", "inherits": ["build-defaults"] },
    {
      "name": "iOS-appstore",
      "configurePreset": "iOS-appstore",
      "configuration": "Release",
      "inherits": ["build-defaults"]
    },
    { "name": "iOS-debug", "configurePreset": "iOS-debug", "configuration": "Debug", "inherits": ["build-defaults"] },
    {
      "name": "iOS-simulator",
      "configurePreset": "iOS-simulator",
      "configuration": "Debug",
      "inherits": ["build-defaults"]
    }
  ],
  "workflowPresets": [
    {
      "name": "iOS",
      "steps": [
        { "type": "configure", "name": "iOS" },
        { "type": "build", "name": "iOS" }
      ]
    },
    {
      "name": "iOS-debug",
      "steps": [
        { "type": "configure", "name": "iOS-debug" },
        { "type": "build", "name": "iOS-debug" }
      ]
    },
    {
      "name": "iOS-simulator",
      "steps": [
        { "type": "configure", "name": "iOS-simulator" },
        { "type": "build", "name": "iOS-simulator" }
      ]
    },
    {
      "name": "iOS-appstore",
      "steps": [
        { "type": "configure", "name": "iOS-appstore" },
        { "type": "build", "name": "iOS-appstore" }
      ]
    }
  ]
}
