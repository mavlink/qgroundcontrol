/*
 * QGC GStreamer static-plugin registration shim. Generated by qgc_gst_generate_static_init()
 * (cmake/GStreamer/StaticInit.cmake).
 *
 * Provides gst_init_static_plugins(), which GStreamer::_registerPlugins() calls on static layouts
 * (Android, iOS, desktop static SDKs) to register the plugins linked into the binary and load the
 * static GIO modules. The GIO module and CA-bundle code ports cerbero's
 * data/ndk-build/gstreamer_android-1.0.c.in (share/gst-android/ndk-build/ in the Android SDK).
 */

#include <gst/gst.h>
#include <gio/gio.h>

#define GST_G_IO_MODULE_DECLARE(name) \
extern void G_PASTE(g_io_, G_PASTE(name, _load)) (gpointer data)

/* Skip the load when the backend GType is already present: gst_init() may already have run this file's
 * gst_init_static_plugins() (see below), and re-registering the GType warns. Type name is openssl-specific
 * (QGC's only module). */
#define GST_G_IO_MODULE_LOAD(name) \
  do { \
    if (g_type_from_name ("GTlsBackendOpenssl") == 0) { \
      G_PASTE(g_io_, G_PASTE(name, _load)) (NULL); \
    } \
  } while (0)

/* Registry-guard each register: the SDKs register none of their static plugins, but a static gst_init() runs
 * any gst_init_static_plugins() it can look up at runtime (gst/gst.c init_static_plugins()). On Android it finds
 * this one, which GStreamer::_registerPlugins() then calls again, and an unconditional re-register aborts
 * ("cannot register existing type GstBaseQTMux"). Lookup keys on the plugin short name, which matches the
 * GST_PLUGIN_STATIC_REGISTER arg. */
#define QGC_REGISTER_STATIC_PLUGIN(name) \
  do { \
    GstPlugin *_qgc_p = gst_registry_find_plugin (gst_registry_get (), G_STRINGIFY (name)); \
    if (_qgc_p == NULL) { \
      GST_PLUGIN_STATIC_REGISTER (name); \
    } else { \
      gst_object_unref (_qgc_p); \
    } \
  } while (0)

@plugin_declarations@

@gio_module_declarations@

/* Load static GIO modules and install the bundled CA bundle as the default TLS database.
 * Port of upstream gstreamer_android-1.0.c:gst_android_load_gio_modules(); no-op when the slot is empty. */
static void
qgc_load_gio_modules_and_ca (void)
{
    const gchar *ca_certs;
    GTlsBackend *backend;

@gio_module_loads@

    ca_certs = g_getenv ("CA_CERTIFICATES");
    backend = g_tls_backend_get_default ();
    if (backend && ca_certs && *ca_certs) {
        GTlsDatabase *db;
        GError *error = NULL;

        db = g_tls_file_database_new (ca_certs, &error);
        if (db) {
            g_tls_backend_set_default_database (backend, db);
            g_object_unref (db);
        } else {
            g_warning ("QGC: failed to load CA bundle '%s': %s",
                ca_certs, error ? error->message : "unknown error");
            g_clear_error (&error);
        }
    }
}

void
gst_init_static_plugins (void)
{
@plugin_registrations@
    qgc_load_gio_modules_and_ca ();
}
