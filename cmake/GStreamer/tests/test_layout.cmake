cmake_minimum_required(VERSION 3.25)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/..")
include("${CMAKE_CURRENT_LIST_DIR}/_assert.cmake")
include(Layout)

qgc_test_sandbox(_sandbox qgc_layout_test_sandbox)

set(_flat "${_sandbox}/flat-sdk")
file(MAKE_DIRECTORY "${_flat}/lib/gstreamer-1.0" "${_flat}/include")
qgc_gst_resolve_layout(SDK_ROOT "${_flat}/../flat-sdk")
qgc_test_assert_streq("root" "${_flat}" "${GStreamer_ROOT_DIR}")
qgc_test_assert_streq("lib" "${_flat}/lib" "${GSTREAMER_LIB_PATH}")
qgc_test_assert_streq("plugins" "${_flat}/lib/gstreamer-1.0" "${GSTREAMER_PLUGIN_PATH}")
qgc_test_assert_streq("include" "${_flat}/include" "${GSTREAMER_INCLUDE_PATH}")
qgc_test_pass("layout")

set(_multi "${_sandbox}/flat-multi")
file(MAKE_DIRECTORY "${_multi}/lib/x86_64-linux-gnu/gstreamer-1.0" "${_multi}/include")
qgc_gst_resolve_layout(SDK_ROOT "${_multi}" LIB_PATH "${_multi}/lib/x86_64-linux-gnu")
qgc_test_assert_streq("multiarch plugins" "${_multi}/lib/x86_64-linux-gnu/gstreamer-1.0" "${GSTREAMER_PLUGIN_PATH}")
qgc_test_pass("LIB_PATH override")

# A root is one path even when it contains the POSIX path-list separator.
if(NOT CMAKE_HOST_WIN32)
    set(_colon "${_sandbox}/flat:sdk")
    file(MAKE_DIRECTORY "${_colon}/lib/gstreamer-1.0" "${_colon}/include")
    qgc_gst_resolve_layout(SDK_ROOT "${_colon}")
    qgc_test_assert_streq("root with ':' lib" "${_colon}/lib" "${GSTREAMER_LIB_PATH}")
    qgc_test_pass("root with ':'")
endif()

set(_bundle "${_sandbox}/GStreamer.framework")
qgc_gst_resolve_layout(SDK_ROOT "${_flat}" FRAMEWORK_BUNDLE "${_bundle}")
qgc_test_assert_streq("framework" "${_bundle}" "${GSTREAMER_FRAMEWORK_PATH}")
qgc_test_pass("FRAMEWORK_BUNDLE")

# The layout store works in script mode too: a key reads back as set, and as "" before it is.
qgc_gst_layout_get(NEVER_SET _none)
qgc_test_assert_streq("unset key" "" "${_none}")
qgc_gst_layout_get(FRAMEWORK_BUNDLE _bundle_key)
qgc_test_assert_streq("FRAMEWORK_BUNDLE key" "${_bundle}" "${_bundle_key}")
qgc_gst_layout_set(FOO bar)
qgc_gst_layout_get(FOO _foo)
qgc_test_assert_streq("set key" "bar" "${_foo}")
qgc_test_pass("layout store in script mode")

# A discovery records its outputs, "" for the ones it left unset, and the Orchestrator copies them back out.
# cmake-lint: disable=C0103
function(_qgc_test_discovery root)
    qgc_gst_resolve_layout(SDK_ROOT "${root}")
    set(GStreamer_AUTO_DOWNLOADED TRUE)
    _qgc_gst_return_discovery()
endfunction()
set(GSTREAMER_XCFRAMEWORK_LIB "")
_qgc_test_discovery("${_flat}")
qgc_gst_layout_get(ROOT_DIR _root_key)
qgc_gst_layout_get(PLUGIN_PATH _plugin_key)
qgc_gst_layout_get(AUTO_DOWNLOADED _auto_key)
qgc_gst_layout_get(XCFRAMEWORK_LIB _xcframework_key)
qgc_test_assert_streq("recorded root" "${_flat}" "${_root_key}")
qgc_test_assert_streq("recorded plugins" "${_flat}/lib/gstreamer-1.0" "${_plugin_key}")
qgc_test_assert_streq("recorded auto-download" "TRUE" "${_auto_key}")
qgc_test_assert_streq("recorded unset key" "" "${_xcframework_key}")
unset(GSTREAMER_PLUGIN_PATH)
qgc_gst_layout_export()
qgc_test_assert_streq("exported plugins" "${_flat}/lib/gstreamer-1.0" "${GSTREAMER_PLUGIN_PATH}")
qgc_test_assert_streq("exported auto-download" "TRUE" "${GStreamer_AUTO_DOWNLOADED}")
qgc_test_pass("discovery records and exports")
