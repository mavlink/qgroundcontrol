# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden quectel/compact
about MSM4 corrections are not supported
request type=quectel role=rtk-base mode=survey-in accuracy=15.0000m duration=10s compact=1 persistent=0 baud=0
stream-step 1 bytes=0 duration=12000ms
stream-step 2 bytes=25 duration=2000ms
configure
  refused "This receiver cannot send compact (MSM4) RTCM corrections"
