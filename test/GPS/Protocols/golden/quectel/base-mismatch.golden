# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden quectel/base-mismatch
about Base settings differ, without consent
request type=quectel role=rtk-base mode=fixed lat=0.00000000 lon=90.00000000 alt=100.0000 accuracy=0.00000m compact=0 persistent=0 baud=0
stream-step 1 bytes=0 duration=12000ms
stream-step 2 bytes=25 duration=2000ms
configure
  result configured=0 baud=0->460800 failure=consent-required ready=0 elapsed=4ms
  identity "LG290P03AANR01A03S"
  error "LG290P base settings mismatch: provision/save the requested ECEF coordinates or survey observation count/accuracy externally, or explicitly allow persistent changes for this connection"
  wire
    baud 460800 configured
    write "PQTMVERNO" 15
      245051544d5645524e4f2a35380d0a
      text "$PQTMVERNO*58\r\n"
    write "PQTMCFGRCVRMODE,R" 23
      245051544d434647524356524d4f44452c522a33320d0a
      text "$PQTMCFGRCVRMODE,R*32\r\n"
    write "PQTMCFGFIXRATE,R" 22
      245051544d434647464958524154452c522a37310d0a
      text "$PQTMCFGFIXRATE,R*71\r\n"
    write "PQTMCFGSVIN,R" 19
      245051544d4346475356494e2c522a32360d0a
      text "$PQTMCFGSVIN,R*26\r\n"
  evidence
    "PQTMVERNO" readback-verified required accepted=15 written=15 uncertain=0 elapsed=1ms
    "PQTMCFGRCVRMODE,R" readback-verified required accepted=23 written=23 uncertain=0 elapsed=1ms
    "PQTMCFGFIXRATE,R" readback-verified required accepted=22 written=22 uncertain=0 elapsed=1ms
    "PQTMCFGSVIN,R" readback-verified required accepted=19 written=19 uncertain=0 elapsed=1ms
  events
