# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden passive/base-settings
about Passive input has no base settings
request type=passive role=passive mode=survey-in accuracy=1.0000m duration=60s compact=0 persistent=0 baud=115200
stream-step 1 bytes=326 duration=1000ms
stream-step 2 bytes=0 duration=6000ms
configure
  refused "This receiver does not support the selected base mode"
