# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden ublox/wire-explicit-baud-mismatch
about Explicit 38400 while the receiver is at 9600
request type=ublox role=rtk-base mode=survey-in accuracy=1.0000m duration=60s compact=0 persistent=0 baud=38400
configure
  result configured=0 baud=38400->38400 failure=none ready=0 elapsed=2020ms
  identity ""
  error "Receiver configuration failed"
  wire
    baud 38400 configured
    write "1034" 8
      b5620a0400000e34
  evidence
