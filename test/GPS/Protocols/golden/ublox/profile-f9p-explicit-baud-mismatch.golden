# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden ublox/profile-f9p-explicit-baud-mismatch
about Requested baud differs from the fixed transport baud
request type=ublox role=rtk-base mode=survey-in accuracy=2.0000m duration=180s compact=0 persistent=0 baud=38400
stream-step 1 bytes=272 duration=1500ms
stream-step 2 bytes=160 duration=1500ms
stream-step 3 bytes=25 duration=3000ms
configure
  refused "Selected baud rate differs from the transport's fixed baud rate"
