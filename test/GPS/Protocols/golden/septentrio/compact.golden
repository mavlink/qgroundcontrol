# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden septentrio/compact
about MSM4 corrections are not supported
request type=septentrio role=rtk-base mode=survey-in accuracy=1.0000m duration=60s compact=1 persistent=0 baud=0
stream-step 1 bytes=268 duration=1000ms
stream-step 2 bytes=25 duration=1000ms
stream-step 3 bytes=0 duration=6000ms
configure
  refused "This receiver cannot send compact (MSM4) RTCM corrections"
