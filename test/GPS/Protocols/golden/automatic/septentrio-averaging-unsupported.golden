# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden automatic/septentrio-averaging-unsupported
about Detected Septentrio cannot average; nothing is configured
request type=automatic role=rtk-base mode=averaging maximum=60s compact=0 persistent=0 baud=0
configure
  result configured=0 baud=0->0 failure=none ready=0 elapsed=3400ms
  identity ""
  detected type=septentrio baud=115200 evidence="identity query"
  error "Detected Septentrio receiver does not support receiver-managed averaging"
  wire
    baud 115200 configured
    write "1034" 8
      b5620a0400000e34
    write "$PASHQ,PRT\r\n" 12
      2450415348512c5052540d0a
      text "$PASHQ,PRT\r\n"
    write "$PASHQ,PRT\r\n" 12
      2450415348512c5052540d0a
      text "$PASHQ,PRT\r\n"
    write "\n\r" 2
      0a0d
      text "\n\r"
  evidence
    "Listen at 115200 baud" timed-out optional accepted=0 written=0 uncertain=0 elapsed=1000ms
    "1034" timed-out required accepted=8 written=8 uncertain=0 elapsed=2000ms
    "$PASHQ,PRT\r\n" timed-out required accepted=12 written=12 uncertain=0 elapsed=200ms
    "$PASHQ,PRT\r\n" timed-out required accepted=12 written=12 uncertain=0 elapsed=200ms
    "\n\r" acknowledged required accepted=2 written=2 uncertain=0 elapsed=0ms
  events
