# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden femto/persistent
about Persistent changes are not supported
request type=femto role=rtk-base mode=survey-in accuracy=1.0000m duration=60s compact=0 persistent=1 baud=0
stream-step 1 bytes=78 duration=1000ms
stream-step 2 bytes=78 duration=1000ms
stream-step 3 bytes=25 duration=1000ms
configure
  refused "This driver does not support persistent receiver configuration"
