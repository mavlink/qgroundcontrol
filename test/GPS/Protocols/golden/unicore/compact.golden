# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden unicore/compact
about MSM4 corrections are not supported
request type=unicore role=rtk-base mode=averaging maximum=5s compact=1 persistent=0 baud=0
stream-step 1 bytes=135 duration=2000ms
stream-step 2 bytes=39 duration=5000ms
stream-step 3 bytes=25 duration=2000ms
configure
  refused "This receiver cannot send compact (MSM4) RTCM corrections"
