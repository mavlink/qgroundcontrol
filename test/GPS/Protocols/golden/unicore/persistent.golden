# Pinned native GPS protocol behaviour. Rewrite only for a justified change (QGC_GPS_GOLDEN_UPDATE=1).
golden unicore/persistent
about Persistent changes are not supported
request type=unicore role=rtk-base mode=averaging maximum=5s compact=0 persistent=1 baud=0
stream-step 1 bytes=135 duration=2000ms
stream-step 2 bytes=39 duration=5000ms
stream-step 3 bytes=25 duration=2000ms
configure
  refused "This driver does not support persistent receiver configuration"
