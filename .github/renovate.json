{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enablePreCommit",
    ":semanticCommitTypeAll(deps)"
  ],
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    ".github/workflows/**"
  ],
  "description": "Manages npm, Python, pre-commit, development environments, Gradle dependencies and Wrapper, Node versions, Dockerfiles, and composite actions. Dependabot owns .github/workflows, which are excluded here.",
  "enabledManagers": [
    "devcontainer",
    "dockerfile",
    "github-actions",
    "gradle-wrapper",
    "npm",
    "pep621",
    "pre-commit",
    "gradle",
    "nvm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "Docker variant base images; docker-compose.yml is generated from variants.json, so both update together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy/docker/variants\\.json$/",
        "/^deploy/docker/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "BASE_REF\"?: \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "The uv required-version floor tracks the Dockerfile's uv image tag; tools/validate_configs.py requires them to match",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/pyproject\\.toml$/"
      ],
      "matchStrings": [
        "required-version = \">=(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch updates after CI passes",
      "matchManagers": [
        "npm",
        "pep621",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Combine every update except Android into one weekly PR, so coupled pins such as the uv required-version floor and the Dockerfile's uv image land together",
      "groupName": "all dependencies",
      "matchManagers": [
        "npm",
        "pep621",
        "pre-commit",
        "github-actions",
        "devcontainer",
        "dockerfile",
        "nvm",
        "custom.regex"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Group Android build updates; the Android Gradle Plugin, Kotlin, and Gradle versions are coupled",
      "groupName": "android dependencies",
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ]
    },
    {
      "description": "Keep lock file maintenance in one PR instead of one per group",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": null
    },
    {
      "description": "Newer androidx.core releases require a compileSdk newer than the one Qt supports",
      "matchPackageNames": [
        "androidx.core:core"
      ],
      "enabled": false
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "priority"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
