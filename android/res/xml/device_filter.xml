<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The USB devices that Android offers to open QGroundControl for, and whose permission it can remember.
         A device that no entry matches is not offered, and has to be allowed again each time it is attached.

         QGCUsbSerialDevices relies on the serial entries: it leaves the permission prompt for a newly attached
         serial device to the dialog that Android shows for a device listed here. QGCUsbSerialDeviceFilterTest
         fails if the serial prober can find a device that no entry matches. IDs are decimal. -->

    <!-- CDC-ACM serial devices, such as flight controllers and GPS receivers: any device with such an interface. -->
    <usb-device class="2" subclass="2" />

    <!-- FTDI: FT232R, FT2232, FT4232H, FT232H, FT-X, FT4232HA (0403:6001, 6010, 6011, 6014, 6015, 6048) -->
    <usb-device vendor-id="1027" product-id="24577" />
    <usb-device vendor-id="1027" product-id="24592" />
    <usb-device vendor-id="1027" product-id="24593" />
    <usb-device vendor-id="1027" product-id="24596" />
    <usb-device vendor-id="1027" product-id="24597" />
    <usb-device vendor-id="1027" product-id="24648" />

    <!-- Silicon Labs CP210x (10c4:ea60, ea70, ea71) -->
    <usb-device vendor-id="4292" product-id="60000" />
    <usb-device vendor-id="4292" product-id="60016" />
    <usb-device vendor-id="4292" product-id="60017" />

    <!-- Prolific PL2303 (067b:2303, 23a3, 23b3, 23c3, 23d3, 23e3, 23f3) -->
    <usb-device vendor-id="1659" product-id="8963" />
    <usb-device vendor-id="1659" product-id="9123" />
    <usb-device vendor-id="1659" product-id="9139" />
    <usb-device vendor-id="1659" product-id="9155" />
    <usb-device vendor-id="1659" product-id="9171" />
    <usb-device vendor-id="1659" product-id="9187" />
    <usb-device vendor-id="1659" product-id="9203" />

    <!-- QinHeng CH340 and CH341 (1a86:7523, 5523) -->
    <usb-device vendor-id="6790" product-id="29987" />
    <usb-device vendor-id="6790" product-id="21795" />

    <!-- Unisoc modems (1782:4d10, 4d12) -->
    <usb-device vendor-id="6018" product-id="19728" />
    <usb-device vendor-id="6018" product-id="19730" />

    <!-- Chrome OS debug cable (18d1:5014) -->
    <usb-device vendor-id="6353" product-id="20500" />

    <!-- Game controllers that SDL opens over USB (HIDDeviceManager): HID devices, which keyboards and mice are
         too, and the vendor-specific interfaces of Xbox 360 and Xbox One controllers. -->
    <usb-device class="3" />
    <usb-device class="255" subclass="93" protocol="1" />
    <usb-device class="255" subclass="93" protocol="129" />
    <usb-device class="255" subclass="71" protocol="208" />
</resources>
