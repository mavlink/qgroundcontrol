{% for block in defs.blocks %}

struct {{ block.name }}
{
{% for field in block.fields %}
    {{ field.type }} {{ field.member }};
{% endfor %}
{% for field in block.fields %}
{% for bits in field.bits %}

{% if bits.type == "bool" %}
    [[nodiscard]] constexpr bool {{ bits.accessor }}() const { return ({{ field.member }} & {{ bits.mask | hex(2) }}) != 0; }
{% elif bits.shift == 0 %}
    [[nodiscard]] constexpr {{ bits.type }} {{ bits.accessor }}() const { return static_cast<{{ bits.type }}>({{ field.member }} & {{ bits.mask | hex(2) }}); }
{% else %}
    [[nodiscard]] constexpr {{ bits.type }} {{ bits.accessor }}() const { return static_cast<{{ bits.type }}>(({{ field.member }} & {{ bits.mask | hex(2) }}) >> {{ bits.shift }}); }
{% endif %}
{% endfor %}
{% endfor %}
};
{% endfor %}

}  // namespace SBF

namespace Wire {
template <>
struct Layout<SBF::BlockHeader>
{
    using T = SBF::BlockHeader;
    static constexpr size_t SIZE = 8;
    static constexpr auto FIELDS =
        std::tuple{Field<&T::sync, 0>{}, Field<&T::crc, 2>{}, Field<&T::id, 4>{}, Field<&T::length, 6>{}};
};
