    "\\.ambr$",
    "^test/GPS/Core/Protocols/(corpus|fixtures)/",
    "^translations/",
    "^android/res/values/strings\\.xml$",
    "^android/src/org/mavlink/qgroundcontrol/QGCActivity\\.java$",
    "^src/AutoPilotPlugins/PX4/(ActuatorFact\\.qml|AirframeComponentController\\.cc|FlightModesComponentSummary\\.qml)$",
    "^src/Comms/MockLink/MockLink\\.General\\.MetaData\\.json$",
